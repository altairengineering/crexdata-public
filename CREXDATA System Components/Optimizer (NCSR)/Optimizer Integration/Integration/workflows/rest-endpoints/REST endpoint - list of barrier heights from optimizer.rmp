      <operator activated="true" class="python_scripting:execute_python" compatibility="10.1.002" expanded="true" height="103" name="Execute Python" width="90" x="45" y="289">
        <parameter key="script" value="import json&#10;import pandas as pd&#10;import ast&#10;&#10;def rm_main(data):&#10;    &quot;&quot;&quot;&#10;    Parse GA optimizer data with string-format parameters&#10;    Returns ALL parameter sets (no limit)&#10;    &quot;&quot;&quot;&#10;    print(f&quot;Input data type: {type(data)}&quot;)&#10;    print(f&quot;Input data: {data}&quot;)&#10;    &#10;    # Parse input data&#10;    if isinstance(data, pd.DataFrame):&#10;        print(f&quot;DataFrame shape: {data.shape}&quot;)&#10;        print(f&quot;DataFrame columns: {data.columns.tolist()}&quot;)&#10;        print(f&quot;DataFrame content:\n{data}&quot;)&#10;        &#10;        if len(data) == 0:&#10;            print(&quot;Error: Input DataFrame is empty&quot;)&#10;            return pd.DataFrame(), pd.DataFrame(['empty'])&#10;        &#10;        # Check if we already have the DataFrame with optimizerRequestID and parameters columns&#10;        if 'optimizerRequestID' in data.columns and 'parameters' in data.columns:&#10;            print(&quot;DataFrame already has optimizerRequestID and parameters columns&quot;)&#10;            &#10;            optimizer_request_id = data.iloc[0]['optimizerRequestID']&#10;            parameters_value = data.iloc[0]['parameters']&#10;            &#10;            print(f&quot;Optimizer ID: {optimizer_request_id}&quot;)&#10;            print(f&quot;Parameters value: {parameters_value}&quot;)&#10;            print(f&quot;Parameters type: {type(parameters_value)}&quot;)&#10;            &#10;            # Parse parameters - could be string or already a list&#10;            if isinstance(parameters_value, str):&#10;                try:&#10;                    parameters = ast.literal_eval(parameters_value)&#10;                    print(f&quot;Parsed with ast.literal_eval: {len(parameters)} items&quot;)&#10;                except Exception as e:&#10;                    print(f&quot;ast.literal_eval failed: {e}&quot;)&#10;                    try:&#10;                        parameters = json.loads(parameters_value)&#10;                        print(f&quot;Parsed with json.loads: {len(parameters)} items&quot;)&#10;                    except Exception as e2:&#10;                        print(f&quot;json.loads also failed: {e2}&quot;)&#10;                        parameters = []&#10;            elif isinstance(parameters_value, list):&#10;                print(f&quot;Parameters already a list with {len(parameters_value)} items&quot;)&#10;                parameters = parameters_value&#10;            else:&#10;                print(f&quot;Unknown parameters type: {type(parameters_value)}&quot;)&#10;                parameters = []&#10;            &#10;            # REMOVED THE LIMIT - Now returns all parameters&#10;            print(f&quot;Returning all {len(parameters)} parameter sets&quot;)&#10;            &#10;            # Create DataFrames&#10;            df_opid = pd.DataFrame([optimizer_request_id])&#10;            df_params = pd.DataFrame(parameters)&#10;            &#10;            print(f&quot;Created df_params with shape: {df_params.shape}&quot;)&#10;            print(f&quot;df_params:\n{df_params}&quot;)&#10;            &#10;            return df_params, df_opid&#10;        &#10;        # Otherwise, try to parse from 'value' column (Kafka format)&#10;        if 'value' in data.columns:&#10;            json_str = data.iloc[-1]['value']&#10;            print(f&quot;JSON string from 'value' column: {json_str}&quot;)&#10;        elif 'parameters' in data.columns:&#10;            json_str = data.iloc[0]['parameters']&#10;            print(f&quot;JSON string from 'parameters' column: {json_str}&quot;)&#10;        else:&#10;            json_str = data.iloc[0, 0]&#10;            print(f&quot;JSON string from first column: {json_str}&quot;)&#10;        &#10;        # Check if json_str is valid&#10;        if not json_str or pd.isna(json_str):&#10;            print(&quot;Error: JSON string is empty or NaN&quot;)&#10;            return pd.DataFrame(), pd.DataFrame(['empty_json'])&#10;        &#10;        try:&#10;            input_data = json.loads(json_str)&#10;            print(f&quot;Successfully parsed JSON: {input_data}&quot;)&#10;        except json.JSONDecodeError as e:&#10;            print(f&quot;JSON decode error: {e}&quot;)&#10;            print(f&quot;Raw string: '{json_str}'&quot;)&#10;            return pd.DataFrame(), pd.DataFrame(['json_error'])&#10;        &#10;    else:&#10;        print(&quot;Input is not a DataFrame&quot;)&#10;        input_data = data&#10;    &#10;    # Extract optimizer data (legacy format with 'data' key)&#10;    if isinstance(input_data, dict) and 'data' in input_data and len(input_data['data']) &gt; 0:&#10;        optimizer_data = input_data['data'][0]&#10;        &#10;        optimizer_request_id = optimizer_data['optimizerRequestID']&#10;        parameters_str = optimizer_data['parameters']&#10;        &#10;        print(f&quot;Optimizer ID: {optimizer_request_id}&quot;)&#10;        print(f&quot;Parameters string: {parameters_str}&quot;)&#10;        print(f&quot;Parameters type: {type(parameters_str)}&quot;)&#10;        &#10;        # Parse string parameters into list of lists&#10;        if isinstance(parameters_str, str):&#10;            try:&#10;                parameters = ast.literal_eval(parameters_str)&#10;                print(f&quot;Parsed with ast.literal_eval: {len(parameters)} items&quot;)&#10;            except Exception as e:&#10;                print(f&quot;ast.literal_eval failed: {e}&quot;)&#10;                try:&#10;                    parameters = json.loads(parameters_str)&#10;                    print(f&quot;Parsed with json.loads: {len(parameters)} items&quot;)&#10;                except Exception as e2:&#10;                    print(f&quot;json.loads also failed: {e2}&quot;)&#10;                    parameters = []&#10;        else:&#10;            parameters = parameters_str&#10;        &#10;        # REMOVED THE LIMIT - Now returns all parameters&#10;        print(f&quot;Returning all {len(parameters)} parameter sets&quot;)&#10;        &#10;        # Create DataFrames&#10;        df_opid = pd.DataFrame([optimizer_request_id])&#10;        df_params = pd.DataFrame(parameters)&#10;        &#10;        print(f&quot;Created df_params with shape: {df_params.shape}&quot;)&#10;        print(f&quot;df_params:\n{df_params}&quot;)&#10;        &#10;        return df_params, df_opid&#10;    &#10;    else:&#10;        print(&quot;No valid data structure found&quot;)&#10;        print(f&quot;input_data type: {type(input_data)}&quot;)&#10;        print(f&quot;input_data: {input_data}&quot;)&#10;        &#10;        # Fallback&#10;        return pd.DataFrame([[4.83, 0.38, 1.32]]), pd.DataFrame(['fallback'])"/>
        <parameter key="notebook_cell_tag_filter" value=""/>
        <parameter key="use_default_python" value="true"/>
        <parameter key="package_manager" value="conda (anaconda)"/>
        <parameter key="use_macros" value="false"/>
      </operator>
