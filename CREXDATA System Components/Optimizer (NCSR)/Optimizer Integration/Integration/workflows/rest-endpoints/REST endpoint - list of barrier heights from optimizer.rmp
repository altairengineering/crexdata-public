      <operator activated="true" class="python_scripting:execute_python" compatibility="10.1.002" expanded="true" height="103" name="Polling Operator" width="90" x="581" y="187">
        <parameter key="script" value="import pandas&#10;import requests&#10;import time&#10;from concurrent.futures import ThreadPoolExecutor, as_completed&#10;&#10;# Polling config&#10;INITIAL_INTERVAL = 0.5&#10;MAX_INTERVAL = 10&#10;BACKOFF_MULTIPLIER = 1.2&#10;MAX_WORKERS = 10  # Number of parallel polling threads&#10;&#10;&#10;def poll_single_simulation(simulation_id, api_token):&#10;    &quot;&quot;&quot;Poll a single simulation until COMPLETE&quot;&quot;&quot;&#10;    api_url = f&quot;https://api.floodwaive.de/v1/simulations/{simulation_id}/progress&quot;&#10;    headers = {&quot;Authorization&quot;: f&quot;Bearer {api_token}&quot;}&#10;    &#10;    interval = INITIAL_INTERVAL&#10;    last_status = None&#10;    &#10;    print(f&quot;[{simulation_id[:8]}...] Starting to poll&quot;)&#10;    &#10;    while True:&#10;        try:&#10;            response = requests.get(api_url, headers=headers, timeout=10)&#10;            response.raise_for_status()&#10;            data = response.json()&#10;            &#10;            status = data.get(&quot;status_v5&quot;, &quot;UNKNOWN&quot;)&#10;            &#10;            if status == &quot;COMPLETE&quot;:&#10;                print(f&quot;[{simulation_id[:8]}...] ✓ COMPLETE!&quot;)&#10;                return {&#10;                    &quot;simulation_id&quot;: simulation_id,&#10;                    &quot;status&quot;: &quot;COMPLETE&quot;,&#10;                    &quot;completed_at&quot;: time.time()&#10;                }&#10;            &#10;            # Only print status changes to reduce log spam&#10;            if status != last_status:&#10;                print(f&quot;[{simulation_id[:8]}...] Status: {status}&quot;)&#10;                interval = INITIAL_INTERVAL&#10;                last_status = status&#10;            else:&#10;                interval = min(interval * BACKOFF_MULTIPLIER, MAX_INTERVAL)&#10;            &#10;            time.sleep(interval)&#10;            &#10;        except requests.RequestException as e:&#10;            print(f&quot;[{simulation_id[:8]}...] Error: {e}. Retrying...&quot;)&#10;            time.sleep(2)&#10;        except Exception as e:&#10;            print(f&quot;[{simulation_id[:8]}...] Unexpected error: {e}&quot;)&#10;            return {&#10;                &quot;simulation_id&quot;: simulation_id,&#10;                &quot;status&quot;: &quot;ERROR&quot;,&#10;                &quot;error&quot;: str(e)&#10;            }&#10;&#10;&#10;def rm_main(data, macros):&#10;    &quot;&quot;&quot;&#10;    RapidMiner main function - Async polling for multiple simulations&#10;    Input: DataFrame with 'simulation_id' column (can have multiple rows)&#10;    Macros: token (API token passed from RapidMiner)&#10;    Output: DataFrame with all simulation_ids and their completion status&#10;    &quot;&quot;&quot;&#10;    # Get token from macros&#10;    api_token = macros.get('token', '')&#10;    &#10;    if not api_token:&#10;        raise ValueError(&quot;API token not provided in macros. Please define 'token' macro in RapidMiner.&quot;)&#10;    &#10;    print('Starting ASYNC simulation polling...')&#10;    &#10;    # Get all simulation IDs from input data&#10;    if 'simulation_id' not in data.columns:&#10;        raise ValueError(&quot;Input data must contain 'simulation_id' column&quot;)&#10;    &#10;    simulation_ids = data['simulation_id'].unique().tolist()&#10;    num_simulations = len(simulation_ids)&#10;    &#10;    print(f&quot;Polling {num_simulations} simulations in parallel...&quot;)&#10;    print(f&quot;Simulation IDs: {[sid[:8] + '...' for sid in simulation_ids]}&quot;)&#10;    &#10;    start_time = time.time()&#10;    results = []&#10;    &#10;    # Poll all simulations in parallel&#10;    with ThreadPoolExecutor(max_workers=min(MAX_WORKERS, num_simulations)) as executor:&#10;        # Submit all polling tasks&#10;        future_to_sim = {&#10;            executor.submit(poll_single_simulation, sim_id, api_token): sim_id &#10;            for sim_id in simulation_ids&#10;        }&#10;        &#10;        # Collect results as they complete&#10;        completed = 0&#10;        for future in as_completed(future_to_sim):&#10;            sim_id = future_to_sim[future]&#10;            try:&#10;                result = future.result()&#10;                results.append(result)&#10;                completed += 1&#10;                print(f&quot;\n[PROGRESS] {completed}/{num_simulations} simulations complete\n&quot;)&#10;            except Exception as e:&#10;                print(f&quot;[{sim_id[:8]}...] Failed with exception: {e}&quot;)&#10;                results.append({&#10;                    &quot;simulation_id&quot;: sim_id,&#10;                    &quot;status&quot;: &quot;FAILED&quot;,&#10;                    &quot;error&quot;: str(e)&#10;                })&#10;                completed += 1&#10;    &#10;    elapsed_time = time.time() - start_time&#10;    print(f&quot;\n{'='*60}&quot;)&#10;    print(f&quot;All {num_simulations} simulations polled in {elapsed_time:.2f} seconds&quot;)&#10;    print(f&quot;Average time per simulation: {elapsed_time/num_simulations:.2f}s&quot;)&#10;    print(f&quot;{'='*60}\n&quot;)&#10;    &#10;    # Return DataFrame with results&#10;    results_df = pandas.DataFrame(results)&#10;    &#10;    print(&quot;Results summary:&quot;)&#10;    print(results_df[['simulation_id', 'status']].to_string())&#10;    &#10;    return results_df"/>
        <parameter key="notebook_cell_tag_filter" value=""/>
        <parameter key="use_default_python" value="true"/>
        <parameter key="package_manager" value="conda (anaconda)"/>
        <parameter key="use_macros" value="true"/>
      </operator>
      <operator activated="true" class="python_scripting:execute_python" compatibility="10.1.002" expanded="true" height="124" name="MaxWaterLevel (2)" width="90" x="715" y="442">
        <parameter key="script" value="import pandas as pd&#10;import numpy as np&#10;import json&#10;import requests&#10;from concurrent.futures import ThreadPoolExecutor, as_completed&#10;&#10;def fetch_fitness_for_simulation(simulation_id, x, y, macros):&#10;    &quot;&quot;&quot;&#10;    Fetch fitness score for a single simulation&#10;    Returns: (simulation_id, fitness_score)&#10;    &quot;&quot;&quot;&#10;    token = macros.get('token')&#10;    try:&#10;        url = f&quot;https://api.floodwaive.de/v1/simulations/{simulation_id}/raw-point-data&quot;&#10;        params = {'x': x, 'y': y}&#10;        headers = {&quot;Authorization&quot;: &quot;Bearer {token}&quot;}&#10;        &#10;        print(f&quot;[{simulation_id[:8]}...] Fetching raw point data...&quot;)&#10;        response = requests.get(url, headers=headers, params=params, timeout=30)&#10;        &#10;        print(f&quot;[{simulation_id[:8]}...] Response Status: {response.status_code}&quot;)&#10;        &#10;        if response.status_code == 200:&#10;            api_data = response.json()&#10;            water_levels = api_data.get('water_levels', [])&#10;            &#10;            if water_levels:&#10;                levels = [entry.get('level', 0.0) for entry in water_levels]&#10;                max_level = max(levels)&#10;                &#10;                print(f&quot;[{simulation_id[:8]}...] Max water level: {max_level}&quot;)&#10;                return (simulation_id, max_level)&#10;            else:&#10;                print(f&quot;[{simulation_id[:8]}...] No water_levels found&quot;)&#10;                return (simulation_id, np.random.rand())&#10;        else:&#10;            print(f&quot;[{simulation_id[:8]}...] API failed: {response.status_code}&quot;)&#10;            return (simulation_id, 999.0)&#10;            &#10;    except Exception as e:&#10;        print(f&quot;[{simulation_id[:8]}...] Error: {e}&quot;)&#10;        return (simulation_id, -1.0)&#10;&#10;&#10;def rm_main(simulation_id_df, kafka_input):&#10;    &quot;&quot;&quot;&#10;    Fetch raw point data for MULTIPLE simulations and return fitness results in GA format&#10;    &#10;    Input:&#10;        - simulation_id_df: DataFrame with multiple rows, each containing a 'simulation_id'&#10;        - kafka_input: DataFrame with Kafka message containing POI and optimizer ID&#10;    &#10;    Output:&#10;        - DataFrame with optimizer ID, list of simulation IDs, and list of fitness scores&#10;    &quot;&quot;&quot;&#10;    print('Fetching raw point data for GA fitness evaluation (BATCH MODE)...')&#10;    &#10;    # Get all simulation IDs from input&#10;    simulation_ids = simulation_id_df['simulation_id'].tolist()&#10;    num_simulations = len(simulation_ids)&#10;    &#10;    print(f&quot;Processing {num_simulations} simulations...&quot;)&#10;    print(f&quot;Simulation IDs: {[sid[:8] + '...' for sid in simulation_ids]}&quot;)&#10;    &#10;    # Get POI and optimizer ID from Kafka&#10;    kafka_data = json.loads(kafka_input.iloc[-1]['value'])&#10;    poi = kafka_data.get('pointOfInterest', '')&#10;    optimizer_request_id = kafka_data.get('optimizerRequestID', '')&#10;    &#10;    x = poi['longitude']&#10;    y = poi['latitude']&#10;    &#10;    print(f&quot;Optimizer Request ID: {optimizer_request_id}&quot;)&#10;    print(f&quot;Point of Interest: ({x}, {y})&quot;)&#10;    &#10;    # Fetch fitness scores in parallel&#10;    results_dict = {}&#10;    &#10;    print(&quot;\n&quot; + &quot;=&quot;*60)&#10;    print(&quot;Starting parallel fitness evaluation...&quot;)&#10;    print(&quot;=&quot;*60 + &quot;\n&quot;)&#10;    &#10;    with ThreadPoolExecutor(max_workers=min(10, num_simulations)) as executor:&#10;        # Submit all fetch tasks&#10;        future_to_sim = {&#10;            executor.submit(fetch_fitness_for_simulation, sim_id, x, y): sim_id &#10;            for sim_id in simulation_ids&#10;        }&#10;        &#10;        # Collect results as they complete&#10;        completed = 0&#10;        for future in as_completed(future_to_sim):&#10;            sim_id, fitness_score = future.result()&#10;            results_dict[sim_id] = fitness_score&#10;            completed += 1&#10;            print(f&quot;[PROGRESS] {completed}/{num_simulations} fitness scores retrieved&quot;)&#10;    &#10;    # Maintain order of simulation IDs from input&#10;    ordered_simulation_ids = simulation_ids&#10;    ordered_fitness_scores = [results_dict[sim_id] for sim_id in ordered_simulation_ids]&#10;    &#10;    print(&quot;\n&quot; + &quot;=&quot;*60)&#10;    print(&quot;Fitness Evaluation Results:&quot;)&#10;    print(&quot;=&quot;*60)&#10;    for sim_id, score in zip(ordered_simulation_ids, ordered_fitness_scores):&#10;        print(f&quot;{sim_id[:8]}... → Fitness: {score}&quot;)&#10;    print(&quot;=&quot;*60 + &quot;\n&quot;)&#10;    &#10;    # Create GA result format&#10;    ga_result = {&#10;        &quot;optimizerRequestID&quot;: optimizer_request_id,&#10;        &quot;simulation_id&quot;: ordered_simulation_ids,  # List of all simulation IDs&#10;        &quot;results&quot;: ordered_fitness_scores  # List of all fitness scores (in same order)&#10;    }&#10;    &#10;    print(f&quot;Returning GA result with {len(ordered_fitness_scores)} fitness scores&quot;)&#10;    &#10;    # Return as DataFrame for RapidMiner compatibility&#10;    result_df = pd.DataFrame([ga_result])&#10;    &#10;    return result_df"/>
