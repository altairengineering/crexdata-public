  <title>Create Rainfall event</title>
  <icon>rain_drops.png</icon>
  <description/>
  <synopsis>Create a Rainfall event for Deepwaive</synopsis>
  <number-of-inputs>1</number-of-inputs>
  <number-of-outputs>1</number-of-outputs>
  <defines-optionals>true</defines-optionals>
  <param-ordering>true</param-ordering>
  <gets-random-seed>true</gets-random-seed>
  <custom-operator-type>standard</custom-operator-type>
  <template-parameters>
    <template-parameter>
      <operator>Text Parameter Macro</operator>
      <parameter>value</parameter>
      <alias>name of the rainfall event</alias>
      <documentation>The text macro value defined by the user.</documentation>
    </template-parameter>
    <template-parameter>
      <operator>Text Parameter Macro (3)</operator>
      <parameter>value</parameter>
      <alias>rainfall event values</alias>
      <documentation>The text macro value defined by the user.</documentation>
    </template-parameter>
    <template-parameter>
      <operator>Text Parameter Macro (2)</operator>
      <parameter>value</parameter>
      <alias>description of the rainfall event</alias>
      <documentation>The text macro value defined by the user.</documentation>
      <optional>true</optional>
    </template-parameter>
  </template-parameters>
  <input-docu>
    <port>
      <type>com.rapidminer.operator.IOObject</type>
      <description>An input port</description>
    </port>
  </input-docu>
  <output-docu>
    <port>
      <type>com.rapidminer.operator.text.Document</type>
      <description>A result port</description>
    </port>
  </output-docu>
  <tutorials/>
</process>
